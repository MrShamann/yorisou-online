# YORISOU local launcher — environment template (LOCAL-LAUNCHER-REFRESH-1).
# Copied to "~/Library/Application Support/YORISOU/yorisou.env.local" on first
# install ONLY (an existing file is never overwritten). Local development only —
# never Production, never Preview. This file may hold LOCAL-ONLY secrets and
# must stay out of every repository (chmod 600).

# Repository the launcher serves (the CURRENT checked-out commit is what runs).
YORISOU_REPO="/Users/yangjin/Projects/yorisou-online"

# Optional branch pin. Empty = no pin. A mismatch is a WARNING, never fatal —
# the launcher never switches branches. (The old pin to a superseded branch was
# removed by LOCAL-LAUNCHER-REFRESH-1.)
YORISOU_EXPECTED_BRANCH=""

# The launcher owns exactly this origin and nothing else.
YORISOU_LOCAL_PORT="3210"
YORISOU_LOCAL_HOST="127.0.0.1"

# Set to 1 to let the launcher apply pending repository migrations to the LOCAL
# database (fail-closed, ON_ERROR_STOP, logged to migration.log). Default: the
# launcher only VALIDATES and refuses to start on missing schema.
YORISOU_AUTO_MIGRATE=""

# Local file-backed data directory used by parts of the app.
YORISOU_DATA_DIR="$HOME/Library/Application Support/YORISOU/data"

# Local-only application settings (fill in locally; never commit values).
YORISOU_ADMIN_EMAILS=""
YORISOU_AUTH_COOKIE_SECRET=""
