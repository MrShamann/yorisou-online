# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# local phase-1 persistence
data/phase1-accounts.json
data/phase1-sessions.json
data/phase1-consultations.json
data/result-visual-asset-registry.json
data/relationship-intelligence/

# Local-store ownership lock. `data/` is a TRACKED directory and is also the local store root, so
# without this the lock lands inside version control. A committed lock names a pid and nonce from
# another machine, and `processIsAlive` would very likely say that pid is alive — classifying the
# root as held and failing every local mutation closed, on every fresh clone, until someone deleted
# the directory by hand. The fail-closed behaviour is right; letting it be committed is not.
data/.local-store-initialized.json
data/.local-store-owner.lock/
data/.local-store-owner.stale-*/
data/.local-store-owner.release-*/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local Claude/QA/runtime artifacts
.claude/
artifacts/
test-results/
result_*.png
yorisou_phase1_*.md
yorisou_phase1_*.zip
Yorisou_Batch_D_Public_Page_Copy_Package*.zip
data/insight-ingestion-*.json

# Local generated types (stale next-typecheck output; excluded from vercel uploads)
tmp/

# Supabase CLI local artifacts (machine-specific, never committed)
supabase/.branches/
supabase/.temp/

# LOCAL APP — runtime lives on the SSD, never in the repo.
scripts/local-app/native/build/
*.icns.tmp
