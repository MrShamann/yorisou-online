{
  "name": "yorisou-online",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "insights:ingest": "tsx scripts/insights-ingest.ts",
    "review:needs": "node --import tsx scripts/review-needs.ts",
    "validate:foundation": "tsx scripts/validate-foundation-repositories.ts",
    "test:agent-runtime": "node --conditions=react-server --import tsx lib/server/agent-runtime/__tests__/phase1.test.ts",
    "test:private-ai-providers": "node --import tsx lib/server/__tests__/privateAiProviderResolver.test.ts",
    "test:experience-cards": "node --conditions=react-server --import tsx lib/server/__tests__/experienceCards.test.ts",
    "test:recommendation-graph": "node --conditions=react-server --import tsx lib/server/__tests__/recommendationGraph.test.ts",
    "test:agent-runtime:db": "bash tests/agent-runtime/postgres-integration.sh",
    "test:c02": "node --import tsx lib/yorisou-tests/__tests__/c02.test.ts",
    "test:relationship-fatigue": "node --import tsx lib/yorisou-tests/__tests__/relationshipFatigue.test.ts",
    "yorisou:assets:check": "node scripts/yorisou/validate-persona-assets.mjs",
    "check:yorisou": "bash scripts/yorisou-check.sh",
    "check:env": "node scripts/yorisou-env-check.mjs",
    "smoke:companion": "node scripts/yorisou/companion-smoke.mjs",
    "test:smoke": "playwright test",
    "test:smoke:headed": "playwright test --headed",
    "smoke:openclaw": "node scripts/openclaw-webhook-smoke.mjs",
    "smoke:hermes": "node scripts/hermes-webhook-smoke.mjs",
    "verify:automation": "npm run check:env && npm run smoke:openclaw && npm run smoke:hermes",
    "test:result-reveal": "node --import tsx lib/yorisou-tests/__tests__/resultReveal.test.ts",
    "test:imairo-snapshot": "node --import tsx lib/yorisou-tests/__tests__/imairoSnapshot.test.ts",
    "test:candidate-intake": "node --import tsx lib/yorisou-tests/__tests__/candidateIntake.test.ts",
    "test:cpv1": "node --import tsx lib/cpv1/__tests__/cpv1Contract.test.ts",
    "test:daily-check-in": "node --import tsx lib/yorisou/methods/daily-check-in/__tests__/dailyCheckIn.test.ts",
    "test:daily-check-in:db": "bash tests/daily-check-in/postgres-integration.sh",
    "generate:daily-check-in": "node scripts/generate-daily-check-in-runtime.mjs",
    "test:yorisou-values": "node --import tsx lib/yorisou/methods/yorisou-values/__tests__/yorisouValues.test.ts",
    "test:yorisou-values:db": "bash tests/yorisou-values/postgres-integration.sh",
    "generate:yorisou-values": "node scripts/generate-yorisou-values-runtime.mjs",
    "test:shared-store": "node --import tsx lib/server/__tests__/sharedObjectStore.test.ts",
    "test:production-pilot": "node --import tsx lib/cpv1/__tests__/productionPilot.test.ts",
    "test:isolation": "node --test tests/verify-local-supabase-target.test.mjs",
    "test:ux2-envelope": "node --import tsx lib/server/__tests__/persistedDimensionSummary.test.ts",
    "test:ux2-routes": "node --import tsx --test app/result/__tests__/resultIdentityRoutes.test.ts",
    "test:ux2-consent": "node --import tsx --test app/result/__tests__/interpretationConsent.test.ts",
    "test:ux2-intent": "node --import tsx --test app/result/__tests__/pendingInterpretationIntent.test.ts",
    "test:ux2-gate": "node --import tsx --test lib/server/__tests__/canonicalDestinationGate.test.ts",
    "test:ux2-reason": "node --import tsx --test lib/yorisou/recommendations/__tests__/governedReason.test.ts",
    "test:ux2-line": "node --import tsx --test app/line/__tests__/anonymousEntryIsolation.test.ts",
    "test:cpc1-acceptance": "playwright test --config=playwright.cpc1.config.ts",
    "typecheck:cpc1-tests": "tsc --noEmit -p tsconfig.tests.json",
    "test:por1-namespace": "node --import tsx --test lib/server/__tests__/recommendationNamespaceSeparation.test.ts",
    "test:por1-controls": "node --import tsx --test lib/server/__tests__/por1RuntimeControls.test.ts",
    "audit:por1-preview-env-isolation": "node scripts/por1-preview-env-isolation-audit.mjs",
    "gate:por1-flag-off-baseline": "node scripts/por1-flag-off-baseline-equivalence.mjs",
    "test:por1-fence": "node --import tsx --test lib/server/__tests__/por1MutationFenceRollout.test.ts",
    "test:por1-boundary": "node --import tsx --test lib/server/__tests__/por1SharedStoreBoundary.test.ts",
    "test:por1-deletion": "node --import tsx --test lib/server/__tests__/por1AccountDeletionLock.test.ts lib/server/__tests__/por1IdentityKeyScope.test.ts",
    "test:por1-context": "node --import tsx --test lib/server/__tests__/por1AccountWriteContext.test.ts",
    "test:por1-transport": "node --conditions=react-server --import tsx --test lib/server/__tests__/por1FoundationTransportParity.test.ts",
    "test:por1-resume:db": "bash tests/por1/postgres-integration.sh",
    "guard:por1-raw-writes": "node scripts/por1-raw-write-source-guard.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1086.0",
    "gray-matter": "^4.0.3",
    "motion": "12.42.2",
    "next": "16.2.10",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  }
}
